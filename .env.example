# ---------------------------------------------------------------------------
# QuickCommerce India — environment configuration (copy to .env, fill in)
# .env is gitignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Anthropic API key — powers the comparison/recommendation reasoning.
#   Format: sk-ant-...
#   Source: https://console.anthropic.com/ (store in a secrets manager in prod)
#   If MISSING: the app still runs and falls back to deterministic, rule-based
#   explanations (clearly labelled). No crash.
QC_ANTHROPIC_API_KEY=

# Model identifier (real, current Claude model id only).
QC_LLM_MODEL=claude-sonnet-4-20250514

# Per-platform request timeout (seconds) for connector probes.
QC_REQUEST_TIMEOUT_S=4.0

# Below this composite confidence the assistant abstains instead of guessing.
QC_ABSTENTION_CONFIDENCE_THRESHOLD=0.55
